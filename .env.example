# Rainyun Rains3 / S3-compatible object storage (server only)
RAIN_S3_ENDPOINT=https://cn-nb1.rains3.com
RAIN_S3_REGION=us-east-1
RAIN_S3_BUCKET=zuopinji
RAIN_S3_ACCESS_KEY_ID=replace-with-a-new-access-key
RAIN_S3_SECRET_ACCESS_KEY=replace-with-a-new-secret-key
RAIN_S3_FORCE_PATH_STYLE=true

# Comma-separated extra production origins, if the collector is behind a proxy.
ANALYTICS_ALLOWED_ORIGINS=https://your-domain.example

# Generate three independent, long random values. Never prefix these with NEXT_PUBLIC_.
ANALYTICS_ADMIN_PASSWORD=replace-with-a-strong-admin-password
ANALYTICS_SESSION_SECRET=replace-with-at-least-32-random-bytes
ANALYTICS_HASH_SALT=replace-with-another-32-random-bytes
